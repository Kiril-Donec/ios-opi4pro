--- /dev/null
+++ b/bsd/dev/a733_power.c
@@ -0,0 +1,471 @@
+/*
+ * Allwinner A733 / Orange Pi 4 Pro platform power: the board's power button
+ * as the iPhone side button, PSCI power-off/restart, and a CPU clock report.
+ *
+ * Button: the PMICs on R_TWI0 (s_twi0, 0x07083000): AXP8191 at 0x36 (main
+ * PMIC, IRQ_STATUS2 0x49: bit 5 PWRON falling = press, bit 6 rising =
+ * release) and AXP515 at 0x34 (charger, INTSTS4 0x4b: bit 5 press, bit 4
+ * release), as the vendor axp2101-pek.c reads them; both are watched, the
+ * board's button sits on one of them. A thread polls the TWI every 50 ms
+ * (the PMIC IRQ line goes through the R-domain NMI controller, unused here)
+ * and drives sweet_hid_key(): a short press is a side button press (lock /
+ * wake); held for PK_CHORD_MS it adds volume up, the iPhone X chord for
+ * "slide to power off". The PMIC's own 6 s hard power-off stays as the
+ * hardware fallback, and a press while the board is off powers it on.
+ *
+ * Power-off: PE_halt_restart -> PSCI SYSTEM_OFF / SYSTEM_RESET (BL31 talks
+ * to the PMIC, as on the vendor Linux), reached after XNU has unmounted the
+ * file systems; the microSD log is flushed first. Panic paths keep the old
+ * behaviour (nothing is powered off).
+ *
+ * CPU clock: the CPU PLL block (0x08870000) is only read and the result
+ * printed, with a timed loop on the boot A76 as a cross-check.
+ *
+ * Boot-args: a733pwrkey=0 turns the button thread off, a733psci_off=0 keeps
+ * the old "halt = spin" behaviour.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(A733_POWER_HOST_TEST)
+
+#ifndef A733_POWER_HOST_TEST
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/sched_prim.h>
+#include <kern/cpu_number.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern void sweet_hid_key(int key, int down);
+extern int (*PE_halt_restart)(unsigned int type);
+extern void a733_sd_log_panic_flush(void);
+#else
+#include <stdbool.h>
+#include <stdint.h>
+#endif
+
+/* ------------------------------------------------------------------ pure */
+
+#define PK_POWER        0               /* sweet_hid_key: side button */
+#define PK_VOLUP        1               /* volume up */
+#define PK_CHORD_MS     1500
+
+struct pk_state {
+	bool down, chord;
+	uint64_t since_ms;
+};
+
+typedef void (*pk_key_fn)(int key, int down);
+
+/* One poll: press/release edges seen since the last poll, and the time. */
+static void
+pk_step(struct pk_state *s, bool press, bool release, uint64_t now_ms, pk_key_fn key)
+{
+	if (press && !s->down) {
+		s->down = true;
+		s->chord = false;
+		s->since_ms = now_ms;
+		key(PK_POWER, 1);
+	}
+	if (s->down && !s->chord && !release && now_ms - s->since_ms >= PK_CHORD_MS) {
+		s->chord = true;
+		key(PK_VOLUP, 1);
+	}
+	if (release && s->down) {
+		if (s->chord) {
+			key(PK_VOLUP, 0);
+		}
+		key(PK_POWER, 0);
+		s->down = false;
+		s->chord = false;
+	}
+}
+
+/*
+ * TWI clock: F_scl = F_in / (10 * (M + 1) * 2^N). Fastest setting not above
+ * max_hz; returns the CCR value (N in bits 2:0, M in bits 6:3).
+ */
+static uint32_t
+twi_ccr_for(uint32_t in_hz, uint32_t max_hz, uint32_t *out_hz)
+{
+	uint32_t best = 0x7u | (0xfu << 3), best_hz = in_hz / (10u * 16u * 128u);
+	for (uint32_t n = 0; n < 8; n++) {
+		for (uint32_t m = 0; m < 16; m++) {
+			uint32_t hz = in_hz / (10u * (m + 1) << n);
+			if (hz <= max_hz && hz > best_hz) {
+				best_hz = hz;
+				best = n | (m << 3);
+			}
+		}
+	}
+	*out_hz = best_hz;
+	return best;
+}
+
+/* R_APBS1 (R_CCU + 0x10): mux 26:24 (dcxo, rtc32k, iosc, pll-peri0-200m, pll-ref), M 4:0. */
+static uint32_t
+r_apbs1_hz(uint32_t reg)
+{
+	static const uint32_t parent[8] = { 24000000, 32768, 16000000, 200000000, 24000000, 24000000, 24000000, 24000000 };
+	return parent[(reg >> 24) & 7] / ((reg & 0x1f) + 1);
+}
+
+/* CPU PLL (nkmp, dcxo 24 MHz): N in bits 15:8; P (2^p) in bits 17:16 of the cpu_clk register. */
+static uint32_t
+cpu_pll_mhz(uint32_t pll, uint32_t clk)
+{
+	uint32_t n = (pll >> 8) & 0xff, p = (clk >> 16) & 3;
+	return (24u * n) >> p;
+}
+
+#ifndef A733_POWER_HOST_TEST
+/* ---------------------------------------------------------------- kernel */
+
+#define RCCU_TWI_BGR            0x019c          /* bit 0 R_TWI0 gate, bit 16 reset */
+#define RCCU_APBS1              0x0010
+
+#define TWI_DATA                0x08
+#define TWI_CNTR                0x0c
+#define TWI_STAT                0x10
+#define TWI_CCR                 0x14
+#define TWI_SRST                0x18
+#define TWI_EFR                 0x1c
+#define TWI_DRV_CTRL            0x200
+#define CNTR_A_ACK              (1u << 2)
+#define CNTR_INT_FLAG           (1u << 3)
+#define CNTR_M_STP              (1u << 4)
+#define CNTR_M_STA              (1u << 5)
+#define CNTR_BUS_EN             (1u << 6)
+
+#define AXP8191_ADDR            0x36
+#define AXP8191_IRQ_EN2         0x41
+#define AXP8191_IRQ_ST2         0x49
+#define AXP8191_PRESS           (1u << 5)
+#define AXP8191_RELEASE         (1u << 6)
+#define AXP515_ADDR             0x34
+#define AXP515_INTEN4           0x43
+#define AXP515_INTSTS4          0x4b
+#define AXP515_PRESS            (1u << 5)
+#define AXP515_RELEASE          (1u << 4)
+
+#define PSCI_SYSTEM_OFF         0x84000008u
+#define PSCI_SYSTEM_RESET       0x84000009u
+
+static struct {
+	vm_offset_t twi, rccu, cpupll;
+	struct pk_state pk;
+	uint32_t errors;
+	bool have[2];
+} pw;
+
+static inline uint32_t rd32(vm_offset_t b, uint32_t o) { return *(volatile uint32_t *)(b + o); }
+static inline void wr32(vm_offset_t b, uint32_t o, uint32_t v) { *(volatile uint32_t *)(b + o) = v; }
+
+static void
+pw_sleep_ms(uint32_t ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline((event_t)&pw, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static uint64_t
+pw_now_ms(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* The vendor engine-mode helpers (twi-sunxi-core.c): INT_FLAG is write-1-to-clear. */
+static void
+twi_clear(void)
+{
+	uint32_t v = rd32(pw.twi, TWI_CNTR);
+	wr32(pw.twi, TWI_CNTR, (v | CNTR_INT_FLAG) & ~(CNTR_M_STA | CNTR_M_STP));
+}
+
+static void
+twi_set(uint32_t bits)
+{
+	uint32_t v = rd32(pw.twi, TWI_CNTR);
+	wr32(pw.twi, TWI_CNTR, (v | bits) & ~CNTR_INT_FLAG);
+}
+
+static int
+twi_wait(void)
+{
+	for (unsigned i = 0; i < 2000; i++) {
+		if (rd32(pw.twi, TWI_CNTR) & CNTR_INT_FLAG) {
+			return (int)(rd32(pw.twi, TWI_STAT) & 0xff);
+		}
+		delay(5);
+	}
+	return -1;
+}
+
+static void
+twi_stop(void)
+{
+	twi_set(CNTR_M_STP);
+	twi_clear();
+	for (unsigned i = 0; i < 200 && (rd32(pw.twi, TWI_CNTR) & CNTR_M_STP); i++) {
+		delay(5);
+	}
+}
+
+/* Send what the previous state asked for, then expect the next status. */
+static bool
+twi_expect(int want, const char *what)
+{
+	int st = twi_wait();
+	if (st == want) {
+		return true;
+	}
+	if (pw.errors++ < 8) {
+		printf("A733 POWER: TWI %s: status 0x%x (expected 0x%x)\n", what, st, want);
+	}
+	twi_stop();
+	return false;
+}
+
+static int
+twi_read(uint8_t addr, uint8_t reg, uint8_t *val)
+{
+	wr32(pw.twi, TWI_CNTR, (rd32(pw.twi, TWI_CNTR) | CNTR_BUS_EN) & ~(CNTR_A_ACK | CNTR_INT_FLAG));
+	twi_set(CNTR_M_STA);
+	if (!twi_expect(0x08, "start")) {
+		return EIO;
+	}
+	wr32(pw.twi, TWI_DATA, (uint32_t)addr << 1);
+	twi_clear();
+	if (!twi_expect(0x18, "address+W")) {
+		return ENXIO;
+	}
+	wr32(pw.twi, TWI_DATA, reg);
+	twi_clear();
+	if (!twi_expect(0x28, "register")) {
+		return EIO;
+	}
+	twi_set(CNTR_M_STA);
+	twi_clear();
+	if (!twi_expect(0x10, "restart")) {
+		return EIO;
+	}
+	wr32(pw.twi, TWI_DATA, ((uint32_t)addr << 1) | 1);
+	twi_clear();
+	if (!twi_expect(0x40, "address+R")) {
+		return EIO;
+	}
+	twi_clear();                            /* one byte: A_ACK stays off -> NACK */
+	if (!twi_expect(0x58, "data")) {
+		return EIO;
+	}
+	*val = (uint8_t)rd32(pw.twi, TWI_DATA);
+	twi_stop();
+	return 0;
+}
+
+static int
+twi_write(uint8_t addr, uint8_t reg, uint8_t val)
+{
+	wr32(pw.twi, TWI_CNTR, (rd32(pw.twi, TWI_CNTR) | CNTR_BUS_EN) & ~(CNTR_A_ACK | CNTR_INT_FLAG));
+	twi_set(CNTR_M_STA);
+	if (!twi_expect(0x08, "start")) {
+		return EIO;
+	}
+	wr32(pw.twi, TWI_DATA, (uint32_t)addr << 1);
+	twi_clear();
+	if (!twi_expect(0x18, "address+W")) {
+		return ENXIO;
+	}
+	wr32(pw.twi, TWI_DATA, reg);
+	twi_clear();
+	if (!twi_expect(0x28, "register")) {
+		return EIO;
+	}
+	wr32(pw.twi, TWI_DATA, val);
+	twi_clear();
+	if (!twi_expect(0x28, "value")) {
+		return EIO;
+	}
+	twi_stop();
+	return 0;
+}
+
+static void
+pw_key(int key, int down)
+{
+	if (pw.errors < 64) {
+		printf("A733 POWER: %s %s\n", key == PK_POWER ? "side button" : "volume up (power-off chord)",
+		    down ? "down" : "up");
+	}
+	sweet_hid_key(key, down);
+}
+
+static const struct {
+	uint8_t addr, en_reg, st_reg, press, release;
+	const char *name;
+} pk_chips[2] = {
+	{ AXP8191_ADDR, AXP8191_IRQ_EN2, AXP8191_IRQ_ST2, AXP8191_PRESS, AXP8191_RELEASE, "AXP8191" },
+	{ AXP515_ADDR, AXP515_INTEN4, AXP515_INTSTS4, AXP515_PRESS, AXP515_RELEASE, "AXP515" },
+};
+
+static bool
+pw_twi_init(void)
+{
+	wr32(pw.rccu, RCCU_TWI_BGR, rd32(pw.rccu, RCCU_TWI_BGR) | (1u << 16) | 1u);
+	delay(10);
+	wr32(pw.twi, TWI_DRV_CTRL, rd32(pw.twi, TWI_DRV_CTRL) & ~1u);   /* engine mode */
+	wr32(pw.twi, TWI_SRST, 1);
+	for (unsigned i = 0; i < 100 && (rd32(pw.twi, TWI_SRST) & 1); i++) {
+		delay(10);
+	}
+	wr32(pw.twi, TWI_EFR, 0);
+	uint32_t in_hz = r_apbs1_hz(rd32(pw.rccu, RCCU_APBS1)), scl;
+	uint32_t ccr = twi_ccr_for(in_hz, 100000, &scl);
+	wr32(pw.twi, TWI_CCR, ccr);
+	wr32(pw.twi, TWI_CNTR, CNTR_BUS_EN);
+	printf("A733 POWER: R_TWI0 in %u Hz, CCR 0x%x -> %u Hz\n", in_hz, ccr, scl);
+	return true;
+}
+
+static void
+pw_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	pw_twi_init();
+	for (unsigned c = 0; c < 2; c++) {
+		uint8_t en = 0;
+		if (twi_read(pk_chips[c].addr, pk_chips[c].en_reg, &en) != 0) {
+			printf("A733 POWER: %s (0x%x) not answering\n", pk_chips[c].name, pk_chips[c].addr);
+			continue;
+		}
+		pw.have[c] = true;
+		uint8_t want = en | pk_chips[c].press | pk_chips[c].release;
+		if (want != en) {
+			(void)twi_write(pk_chips[c].addr, pk_chips[c].en_reg, want);
+		}
+		/* Drop edges left over from power-on. */
+		(void)twi_write(pk_chips[c].addr, pk_chips[c].st_reg, pk_chips[c].press | pk_chips[c].release);
+		printf("A733 POWER: %s power key IRQ enable 0x%02x -> 0x%02x\n", pk_chips[c].name, en, want);
+	}
+	if (!pw.have[0] && !pw.have[1]) {
+		printf("A733 POWER: no PMIC on R_TWI0; power button off\n");
+		return;
+	}
+	printf("A733 POWER: power button ready (short press: lock/wake, hold %u ms: slide to power off)\n",
+	    PK_CHORD_MS);
+	for (;;) {
+		bool press = false, release = false;
+		for (unsigned c = 0; c < 2; c++) {
+			uint8_t st;
+			if (!pw.have[c] || twi_read(pk_chips[c].addr, pk_chips[c].st_reg, &st) != 0) {
+				continue;
+			}
+			uint8_t edges = st & (pk_chips[c].press | pk_chips[c].release);
+			if (edges) {
+				(void)twi_write(pk_chips[c].addr, pk_chips[c].st_reg, edges);
+				press |= (edges & pk_chips[c].press) != 0;
+				release |= (edges & pk_chips[c].release) != 0;
+			}
+		}
+		pk_step(&pw.pk, press, release, pw_now_ms(), pw_key);
+		pw_sleep_ms(50);
+	}
+}
+
+static int32_t
+pw_psci(uint32_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile("smc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11",
+	    "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return (int32_t)x0;
+}
+
+/* kPEHaltCPU 0, kPERestartCPU 1 (IOPlatformExpert.h); everything else as before. */
+static int
+a733_halt_restart(unsigned int type)
+{
+	if (type != 0 && type != 1) {
+		return -1;
+	}
+	printf("A733 POWER: %s via PSCI\n", type == 0 ? "power off" : "restart");
+	a733_sd_log_panic_flush();
+	int32_t rc = pw_psci(type == 0 ? PSCI_SYSTEM_OFF : PSCI_SYSTEM_RESET);
+	printf("A733 POWER: PSCI returned %d\n", rc);
+	return -1;
+}
+
+static void
+pw_cpu_report(void)
+{
+	static const struct {
+		uint32_t pll, clk;
+		const char *name;
+	} cl[3] = {
+		{ 0x1000, 0x101c, "A55 (cpu_l)" }, { 0x2000, 0x201c, "A76 (cpu_b)" }, { 0x3000, 0x301c, "DSU" },
+	};
+	static const char *const mux[8] = { "dcxo", "dcxo", "dcxo", "own PLL", "peri0-2x", "back PLL", "?", "?" };
+	uint32_t back = rd32(pw.cpupll, 0x0000);
+	uint32_t back_mhz = 24u * ((back >> 8) & 0xff) / ((back & 0xf) + 1);
+	for (unsigned i = 0; i < 3; i++) {
+		uint32_t pll = rd32(pw.cpupll, cl[i].pll), clk = rd32(pw.cpupll, cl[i].clk);
+		printf("A733 CPU: %s pll 0x%08x clk 0x%08x: source %s, PLL %u MHz (back PLL %u MHz)\n",
+		    cl[i].name, pll, clk, mux[(clk >> 24) & 7], cpu_pll_mhz(pll, clk), back_mhz);
+	}
+	/* Cross-check: one dependent subtract+branch per cycle on the boot A76. */
+	const uint64_t iters = 20000000;
+	uint64_t n = iters, t0 = mach_absolute_time();
+	__asm__ volatile("1: subs %0, %0, #1\n\tb.ne 1b" : "+r"(n) : : "cc");
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	printf("A733 CPU: timed loop on cpu %d: about %llu MHz\n", cpu_number(), ns ? iters * 1000 / ns : 0);
+}
+
+/* Called from IOFindBSDRoot (once); the button runs in its own thread. */
+void a733_power_start(void);
+
+void
+a733_power_start(void)
+{
+	DTEntry node;
+	uintptr_t const *twi = NULL, *rccu = NULL, *cpupll = NULL;
+	unsigned int s1 = 0, s2 = 0, s3 = 0;
+	uint32_t on = 1, psci_off = 1;
+	thread_t thread;
+	static bool started;
+
+	if (started || SecureDTLookupEntry(NULL, "/a733-power", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "twi-reg", (void const **)&twi, &s1) != kSuccess || s1 < 2 * sizeof(uintptr_t) ||
+	    SecureDTGetProperty(node, "rccu-reg", (void const **)&rccu, &s2) != kSuccess || s2 < 2 * sizeof(uintptr_t) ||
+	    SecureDTGetProperty(node, "cpupll-reg", (void const **)&cpupll, &s3) != kSuccess ||
+	    s3 < 2 * sizeof(uintptr_t)) {
+		return;
+	}
+	started = true;
+	pw.twi = ml_io_map(twi[0], 0x1000);
+	pw.rccu = ml_io_map(rccu[0], 0x1000);
+	pw.cpupll = ml_io_map(cpupll[0], 0x4000);
+	if (pw.cpupll) {
+		pw_cpu_report();
+	}
+	PE_parse_boot_argn("a733psci_off", &psci_off, sizeof(psci_off));
+	if (psci_off) {
+		PE_halt_restart = a733_halt_restart;
+		printf("A733 POWER: halt/restart -> PSCI SYSTEM_OFF/SYSTEM_RESET\n");
+	}
+	PE_parse_boot_argn("a733pwrkey", &on, sizeof(on));
+	if (on && pw.twi && pw.rccu && kernel_thread_start(pw_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* !A733_POWER_HOST_TEST */
+#endif /* ARM64_BOARD_CONFIG_SWEET || A733_POWER_HOST_TEST */
diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 41d51dc..09861ae 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,16 +73,19 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
-	/* A733: only the two Cortex-A76 cores (MPIDR 0x600 boots, 0x700 with cpus=2). */
-	if ((cpu->phys_id != 0x600 && cpu->phys_id != 0x700) ||
-	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+	/*
+	 * A733 (DynamIQ, one core per Aff1): Cortex-A55 0x000-0x500, Cortex-A76
+	 * 0x600 (boots) and 0x700. The ADT lists the A76s first, so cpus=N
+	 * takes them before the A55s.
+	 */
+	if ((cpu->phys_id & ~0x700u) != 0 || topology->num_cpus > SWEET_SMP_MAX_CPUS) {
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy("Cortex-A76");
+	cpuName = OSSymbol::withCStringNoCopy(cpu->phys_id >= 0x600 ? "Cortex-A76" : "Cortex-A55");
 	if (cpuName == NULL) {
 		return false;
