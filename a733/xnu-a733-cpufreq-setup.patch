+/* Efuse word at SID + 0x24C -> OPP column, and the vendor index it stands for. */
+static int
+cf_column(uint32_t sid_24c, uint16_t *index)
+{
+	uint32_t ori = (sid_24c >> 8) & 0xff, bak = (sid_24c >> 16) & 0xff;
+	uint32_t dvfs = bak ? bak : ori;
+	uint16_t idx = 0x0100;                  /* the vendor default when nothing matches */
+	for (unsigned i = 0; i < CF_N(cf_vf_map); i++) {
+		if (cf_vf_map[i].code == dvfs) {
+			idx = cf_vf_map[i].index;
+			break;
+		}
+	}
+	*index = idx;
+	/* 0x0101 / 0x0201 have no rows in the V0.9 tables: use their base bins. */
+	uint16_t col_idx = (idx == 0x0101 || idx == 0x0201) ? (uint16_t)(idx & 0xff00) : idx;
+	for (int c = 0; c < CF_BINS; c++) {
+		if (cf_bins[c] == col_idx) {
+			return c;
+		}
+	}
+	return -1;
+}
+
+/* Highest row of t for column col with mv <= max_mv and mhz in [min_mhz, max_mhz]; -1 if none. */
+static int
+cf_pick(const struct cf_opp *t, unsigned n, int col, uint16_t max_mv, uint16_t min_mhz, uint16_t max_mhz)
+{
+	int best = -1;
+	for (unsigned i = 0; i < n; i++) {
+		uint16_t mv = t[i].mv[col];
+		if (mv && mv <= max_mv && t[i].mhz >= min_mhz && t[i].mhz <= max_mhz) {
+			best = (int)i;
+		}
+	}
+	return best;
+}
+
+/* Next usable row below / above row r for column col (r itself if none). */
+static int
+cf_step(const struct cf_opp *t, unsigned n, int col, int r, int dir, uint16_t min_mhz, int limit)
+{
+	for (int i = r + dir; i >= 0 && i < (int)n && (dir < 0 || i <= limit); i += dir) {
+		if (t[i].mv[col] && t[i].mhz >= min_mhz) {
+			return i;
+		}
+	}
+	return r;
+}
+
+/* AXP8191 DCDC2-5: 0.5 V + 10 mV/step up to 1.2 V (code 0x46), then 20 mV/step. */
+static uint8_t
+cf_mv_code(uint16_t mv)
+{
+	if (mv < 500) {
+		mv = 500;
+	}
+	if (mv <= 1200) {
+		return (uint8_t)((mv - 500) / 10);
+	}
+	return (uint8_t)(0x47 + (mv - 1220 + 19) / 20);
+}
+
+static uint16_t
+cf_code_mv(uint8_t code)
+{
+	code &= 0x7f;
+	return code <= 0x46 ? (uint16_t)(500 + 10 * code) : (uint16_t)(1220 + 20 * (code - 0x47));
+}
+
+/* CPU PLL N for mhz at 24 MHz with P = 1 (N 28..94); 0 if not reachable. */
+static uint32_t
+cf_pll_n(uint16_t mhz)
+{
+	if (mhz % 24) {
+		return 0;
+	}
+	uint32_t n = mhz / 24u;
+	return (n >= 28 && n <= 94) ? n : 0;
+}
+
+/*
+ * THS (sun60iw2p1, sunxi_thermal.c): code -> millidegrees C, and the per
+ * sensor calibration value from the three efuse words at SID + 0x244..0x24C.
+ */
+static int
+ths_mc(int reg)
+{
+	return reg > 1769 ? (reg - 2822) * -62 : (reg - 2835) * -59;
+}
+
+static int
+ths_calib(const uint32_t cal[3], unsigned i, uint32_t *cdata)
+{
+	int ft = (int)(cal[0] & 0xfff), reg;
+	if (!ft) {
+		return -1;
+	}
+	switch (i) {
+	case 0: reg = (int)((cal[0] >> 12) & 0xfff); break;
+	case 1: reg = (int)(((cal[0] >> 24) | (cal[1] << 8)) & 0xfff); break;
+	case 2: reg = (int)((cal[1] >> 4) & 0xfff); break;
+	case 3: reg = (int)((cal[1] >> 16) & 0xfff); break;
+	case 4: reg = (int)(((cal[1] >> 28) | (cal[2] << 4)) & 0xfff); break;
+	default: return -1;
+	}
+	int delta = (ft * 100 - ths_mc(reg)) / -62;
+	int c = 0x800 - delta;
+	if (c & ~0xfff) {
+		return -1;
+	}
+	*cdata = (uint32_t)c;
+	return 0;
+}
+
+/* Thermal policy (vendor trips: passive 90 C, critical 110 C). */
+#define CF_HOT_MC       90000
+#define CF_COOL_MC      80000
+#define CF_CRIT_MC      105000
+
+enum { CF_HOLD = 0, CF_DOWN = -1, CF_UP = 1, CF_FLOOR = -2 };
+
+static int
+cf_thermal_action(int mc)
+{
+	if (mc >= CF_CRIT_MC) {
+		return CF_FLOOR;
+	}
+	if (mc >= CF_HOT_MC) {
+		return CF_DOWN;
+	}
+	if (mc < CF_COOL_MC) {
+		return CF_UP;
+	}
+	return CF_HOLD;
+}
