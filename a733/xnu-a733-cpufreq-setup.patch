+/*
+ * Flush the console log now, from normal thread context (a733_power.c calls
+ * it before every CPU voltage / PLL step). False while the log is not set up.
+ */
+bool a733_sd_log_sync(void);
+
+bool
+a733_sd_log_sync(void)
+{
+	if (!sdlog.ready || sdlog.failed) {
+		return false;
+	}
+	lck_mtx_lock(&a733_sd_lock);
+	int error = sdlog_flush();
+	lck_mtx_unlock(&a733_sd_lock);
+	return error == 0 || error == EAGAIN;
+}
