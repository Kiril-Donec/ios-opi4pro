+/*
+ * A733: one-time changes to the iOS root on the first boot that has them
+ * (Setup skip), written by the kernel right after the root mount (hook in
+ * bsd_init), through HFS and its journal, before launchd runs.
+ *
+ * The keys are the ones upstream tools/sweet-root-tweaks.py merges into the
+ * phone images that reach the home screen: Setup done (purplebuddy), no
+ * mini-buddies / cloud configuration, the data migration recorded as done
+ * for 20H392 (no "iOS updated" screen and no hour-long datamigrator runs),
+ * SpringBoard without launch watchdogs, and the mobileactivationd data ark
+ * (only if its system container is where the upstream image has it; the
+ * Activated state itself comes from the /chosen security properties in the
+ * ADT, mkadt_a733.py --activation). Plus Reduce Motion and Reduce
+ * Transparency: every frame is drawn by the CPU here (no GPU).
+ *
+ * The preference files are written whole (XML plists), not merged. A marker
+ * file is written last, so this runs once; boot-arg a733setupskip=0 turns
+ * it off, a733setupskip=2 writes again even with the marker.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/namei.h>
+#include <sys/kauth.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+
+#define FB_MOBILE       501
+#define FB_PREFS        "/private/var/mobile/Library/Preferences/"
+#define FB_MARKER       "/private/var/root/.a733-firstboot-v1"
+#define FB_ARK_DIR      "/private/var/containers/Data/System/D90C94C4-F94E-4FCF-8A28-A93BE3846D8E"
+
+#define FB_HEAD "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" \
+	"<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n" \
+	"<plist version=\"1.0\">\n<dict>\n"
+#define FB_TAIL "</dict>\n</plist>\n"
+
+static const struct {
+	const char *name;
+	const char *body;
+} fb_prefs[] = {
+	{ "com.apple.purplebuddy.plist",
+	  "\t<key>SetupDone</key>\n\t<true/>\n"
+	  "\t<key>SetupFinishedAllSteps</key>\n\t<true/>\n"
+	  "\t<key>SetupVersion</key>\n\t<integer>11</integer>\n"
+	  "\t<key>daemonizeNeedsToRun</key>\n\t<false/>\n" },
+	{ "com.apple.purplebuddy.notbackedup.plist",
+	  "\t<key>ShouldRunDiagnosticsMiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>ShouldRunHSA2MiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>ShouldRunKeychainSyncMiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>ShouldRunMesaMiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>ShouldRunPaymentMiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>ShouldRunStandardMiniBuddy</key>\n\t<false/>\n"
+	  "\t<key>SilentICDPUpgrade</key>\n\t<false/>\n" },
+	{ "com.apple.managedconfiguration.notbackedup.plist",
+	  "\t<key>LockdownActivationIndicatesCloudConfigurationAvailable</key>\n\t<false/>\n" },
+	{ "com.apple.migration.plist",
+	  "\t<key>LastSystemVersion</key>\n\t<string>20H392</string>\n"
+	  "\t<key>DMUserDataDisposition</key>\n\t<dict>\n"
+	  "\t\t<key>SyntheticDidUpgrade</key>\n\t\t<false/>\n"
+	  "\t\t<key>buildVersion</key>\n\t\t<string>20H392</string>\n\t</dict>\n" },
+	{ "com.apple.springboard.plist",
+	  "\t<key>BKNoWatchdogs</key>\n\t<true/>\n"
+	  "\t<key>FBLaunchWatchdogExceptions</key>\n\t<dict>\n"
+	  "\t\t<key>com.apple.purplebuddy</key>\n\t\t<real>100</real>\n\t</dict>\n"
+	  "\t<key>MCForceShowCloudConfigurationUI</key>\n\t<false/>\n" },
+	{ "com.apple.Accessibility.plist",
+	  "\t<key>ReduceMotionEnabled</key>\n\t<true/>\n"
+	  "\t<key>EnhancedBackgroundContrastEnabled</key>\n\t<true/>\n" },
+};
+
+static const char fb_ark_body[] =
+    "\t<key>-ActivationState</key>\n\t<string>Activated</string>\n"
+    "\t<key>-BrickState</key>\n\t<false/>\n"
+    "\t<key>-BuildVersion</key>\n\t<string>20H392</string>\n"
+    "\t<key>-ProductVersion</key>\n\t<string>16.7.16</string>\n"
+    "\t<key>-DataMigrationCompleted</key>\n\t<true/>\n"
+    "\t<key>-PreSydroDataMigrationCompleted</key>\n\t<true/>\n";
+
+static bool
+fb_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
+}
+
+static int
+fb_write(const char *path, const char *head, const char *body, const char *tail, uid_t uid, mode_t mode)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, mode, VNODE_LOOKUP_NOFOLLOW, &vp, ctx);
+	if (error) {
+		return error;
+	}
+	const char *parts[3] = { head, body, tail };
+	off_t off = 0;
+	for (unsigned i = 0; i < 3 && !error; i++) {
+		int len = (int)strlen(parts[i]), resid = 0;
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)parts[i], len, off, UIO_SYSSPACE,
+		    IO_NODELOCKED | IO_UNIT, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!error && resid) {
+			error = EIO;
+		}
+		off += len;
+	}
+	if (!error) {
+		struct vnode_attr va;
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, uid);
+		VATTR_SET(&va, va_mode, mode);
+		error = vnode_setattr(vp, &va, ctx);
+	}
+	int cerr = vnode_close(vp, FWRITE, ctx);
+	return error ? error : cerr;
+}
+
+/* mkdir path (one level) owned by uid; an existing directory is fine. */
+static int
+fb_mkdir(const char *path, uid_t uid)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct nameidata nd;
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT, UIO_SYSSPACE, CAST_USER_ADDR_T(path), ctx);
+	int error = namei(&nd);
+	if (error) {
+		return error;
+	}
+	if (nd.ni_vp != NULLVP) {
+		vnode_put(nd.ni_vp);
+	} else {
+		VATTR_INIT(&va);
+		VATTR_SET(&va, va_type, VDIR);
+		VATTR_SET(&va, va_mode, 0755);
+		VATTR_SET(&va, va_uid, uid);
+		VATTR_SET(&va, va_gid, uid);
+		error = vn_mkdir(nd.ni_dvp, &vp, &nd, &va, ctx);
+		if (!error && vp != NULLVP) {
+			vnode_put(vp);
+		}
+	}
+	vnode_put(nd.ni_dvp);
+	nameidone(&nd);
+	return error;
+}
+
+/* True if the first 4 KiB of path contain needle (a binary plist string). */
+static bool
+fb_file_has(const char *path, const char *needle)
+{
+	static char buf[4096];
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0;
+	if (vnode_open(path, FREAD | O_NOFOLLOW, 0, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) != 0) {
+		return false;
+	}
+	int error = vn_rdwr(UIO_READ, vp, buf, (int)sizeof(buf), 0, UIO_SYSSPACE, IO_NODELOCKED,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	(void)vnode_close(vp, FREAD, ctx);
+	if (error) {
+		return false;
+	}
+	size_t n = sizeof(buf) - (size_t)resid, nl = strlen(needle);
+	for (size_t i = 0; i + nl <= n; i++) {
+		if (memcmp(buf + i, needle, nl) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void a733_firstboot_tweaks(void);
+
+void
+a733_firstboot_tweaks(void)
+{
+	static char path[256];
+	uint32_t mode = 1;
+	unsigned ok = 0, failed = 0;
+
+	PE_parse_boot_argn("a733setupskip", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	if (mode != 2 && fb_exists(FB_MARKER)) {
+		printf("A733 FIRSTBOOT: done before (%s), nothing to do\n", FB_MARKER);
+		return;
+	}
+	if (!fb_exists(FB_PREFS)) {
+		printf("A733 FIRSTBOOT: %s missing, not an iOS root; skipped\n", FB_PREFS);
+		return;
+	}
+	for (unsigned i = 0; i < sizeof(fb_prefs) / sizeof(fb_prefs[0]); i++) {
+		snprintf(path, sizeof(path), "%s%s", FB_PREFS, fb_prefs[i].name);
+		int error = fb_write(path, FB_HEAD, fb_prefs[i].body, FB_TAIL, FB_MOBILE, 0600);
+		printf("A733 FIRSTBOOT: %s %s (%d)\n", fb_prefs[i].name, error ? "FAILED" : "written", error);
+		if (error) {
+			failed++;
+		} else {
+			ok++;
+		}
+	}
+	/* mobileactivationd data ark, only in the upstream image's container. */
+	if (fb_file_has(FB_ARK_DIR "/.com.apple.mobile_container_manager.metadata.plist",
+	    "com.apple.mobileactivationd")) {
+		int error = fb_mkdir(FB_ARK_DIR "/Library", FB_MOBILE);
+		if (!error) {
+			error = fb_mkdir(FB_ARK_DIR "/Library/internal", FB_MOBILE);
+		}
+		if (!error) {
+			error = fb_write(FB_ARK_DIR "/Library/internal/data_ark.plist", FB_HEAD, fb_ark_body, FB_TAIL,
+			    FB_MOBILE, 0600);
+		}
+		printf("A733 FIRSTBOOT: activation data ark %s (%d)\n", error ? "FAILED" : "written", error);
+		if (error) {
+			failed++;
+		} else {
+			ok++;
+		}
+	} else {
+		printf("A733 FIRSTBOOT: mobileactivationd container not at the upstream path; data ark skipped "
+		    "(activation from the ADT security properties only)\n");
+	}
+	if (failed == 0) {
+		int error = fb_write(FB_MARKER, "", "A733 first-boot changes v1 (Setup skip)\n", "", 0, 0644);
+		printf("A733 FIRSTBOOT: %u files written, marker %s (%d)\n", ok, error ? "FAILED" : "written", error);
+	} else {
+		printf("A733 FIRSTBOOT: %u written, %u failed; no marker, retried next boot\n", ok, failed);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
