+static void pw_cpu_report(void);
+#define CF_NO_TEMP              (-2147483647 - 1)
+
+/* ------------------------------------------------------- CPU frequency */
+
+#define AXP8191_DCDC_CTL1       0x10            /* bit 2 DCDC3, bit 4 DCDC5 enabled */
+#define AXP8191_DC3_VOL         0x14            /* DCDC3: Cortex-A76 cluster */
+#define AXP8191_DC5_VOL         0x16            /* DCDC5: Cortex-A55 cluster + DSU */
+#define CPUPLL_A55              0x1000
+#define CPUPLL_A76              0x2000
+#define CPUPLL_DSU              0x3000
+#define PLL_UPDATE              (1u << 26)      /* "clear" in ccu-sun60iw2-cpupll.c */
+#define PLL_LOCK                (1u << 28)
+#define CF_MAX_MV               1050            /* highest voltage in the vendor tables */
+#define CF_FLOOR_MHZ            1008            /* thermal floor for both clusters */
+
+#define SID_DVFS                0x24c
+#define SID_THS_CAL             0x244           /* + 0x248, 0x24c */
+#define CCU_GPADC0_24M          0x0fc0          /* bit 31 gate, 26:24 mux (0 sys24M), 4:0 M */
+#define CCU_GPADC0_BGR          0x0fc4          /* bit 0 gate, bit 16 reset */
+#define CCU_THS0_BGR            0x0fe4          /* bit 0 gate, bit 16 reset */
+#define THS_CTRL0               0x00
+#define THS_ENABLE              0x04
+#define THS_PC                  0x08
+#define THS_DATA_INTS           0x20
+#define THS_MFC                 0x30
+#define THS_CALIB               0xa0
+#define THS_DATA                0xc0
+#define THS_SENSORS             5               /* 0: A76 (cpub), 3: A55 (cpul) */
+
+static struct {
+	vm_offset_t sid, ths, ccu;
+	int col;                        /* OPP column (chip bin); -1: cpufreq off */
+	uint16_t index;
+	int a76, a55, dsu;              /* current OPP rows; -1 = U-Boot's clock */
+	int a76_max, a55_max;           /* targets of the chosen level */
+	uint16_t v3, v5;                /* rail voltages now (mV) */
+	bool ths_ok;
+	int last_mc;
+} cf = { .col = -1, .a76 = -1, .a55 = -1, .dsu = -1 };
+
+static void
+cf_sync(void)
+{
+	(void)a733_sd_log_sync();
+}
+
+static int
+cf_read_mv(uint8_t reg, uint16_t *mv)
+{
+	uint8_t code;
+	int error = twi_read(AXP8191_ADDR, reg, &code);
+	if (!error) {
+		*mv = cf_code_mv(code);
+	}
+	return error;
+}
+
+/* Rail to mv, then wait for the 250 uV/us ramp (vendor DT) twice over, then read back. */
+static int
+cf_set_mv(uint8_t reg, uint16_t mv, uint16_t *cur)
+{
+	uint8_t code = cf_mv_code(mv), back = 0;
+	if (mv > CF_MAX_MV || mv < 700) {
+		return EINVAL;
+	}
+	printf("A733 CPUFREQ: rail 0x%02x %u -> %u mV\n", reg, *cur, mv);
+	cf_sync();
+	if (twi_write(AXP8191_ADDR, reg, code) != 0) {
+		return EIO;
+	}
+	uint32_t delta = mv > *cur ? (uint32_t)(mv - *cur) : (uint32_t)(*cur - mv);
+	delay((int)(200 + delta * 8));
+	if (twi_read(AXP8191_ADDR, reg, &back) != 0 || (back & 0x7f) != code) {
+		printf("A733 CPUFREQ: rail 0x%02x read back 0x%02x, wanted 0x%02x\n", reg, back, code);
+		return EIO;
+	}
+	*cur = mv;
+	return 0;
+}
+
+/* In-place PLL retune as ccu_nkmp_set_rate(): N, update bit, wait for lock. */
+static int
+cf_set_pll(uint32_t off, uint16_t mhz, const char *name)
+{
+	uint32_t n = cf_pll_n(mhz), clk = rd32(pw.cpupll, off + 0x1c);
+	if (!n || ((clk >> 24) & 7) != 3 || ((clk >> 16) & 3) != 0) {
+		printf("A733 CPUFREQ: %s not on its own PLL with P=1 (clk 0x%08x); left alone\n", name, clk);
+		return EINVAL;
+	}
+	printf("A733 CPUFREQ: %s PLL -> %u MHz (N %u)\n", name, mhz, n);
+	cf_sync();
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	uint32_t reg = (rd32(pw.cpupll, off) & ~(0xffu << 8)) | (n << 8);
+	wr32(pw.cpupll, off, reg);
+	wr32(pw.cpupll, off, reg | PLL_UPDATE);
+	int error = 0;
+	unsigned i, locked = 0;
+	for (i = 0; i < 1000 && (rd32(pw.cpupll, off) & PLL_UPDATE); i++) {
+		delay(10);
+	}
+	if (i == 1000) {
+		error = ETIMEDOUT;
+	}
+	for (i = 0; !error && i < 7000 && locked < 3; i++) {
+		locked = (rd32(pw.cpupll, off) & PLL_LOCK) ? locked + 1 : 0;
+		delay(3);
+	}
+	if (!error && locked < 3) {
+		error = ETIMEDOUT;
+	}
+	ml_set_interrupts_enabled(istate);
+	if (error) {
+		printf("A733 CPUFREQ: %s PLL did not lock (0x%08x)\n", name, rd32(pw.cpupll, off));
+	}
+	return error;
+}
+
+/* Move to the given rows: raise rails first, retune, then lower rails. */
+static int
+cf_apply(int a76, int a55, int dsu)
+{
+	uint16_t w3 = cf_a76[a76].mv[cf.col];
+	uint16_t w5 = cf_a55[a55].mv[cf.col] > cf_dsu[dsu].mv[cf.col] ? cf_a55[a55].mv[cf.col] : cf_dsu[dsu].mv[cf.col];
+	int error = 0;
+	if (w3 > cf.v3) {
+		error = cf_set_mv(AXP8191_DC3_VOL, w3, &cf.v3);
+	}
+	if (!error && w5 > cf.v5) {
+		error = cf_set_mv(AXP8191_DC5_VOL, w5, &cf.v5);
+	}
+	if (error) {
+		return error;
+	}
+	if (a76 != cf.a76 && (error = cf_set_pll(CPUPLL_A76, cf_a76[a76].mhz, "A76")) == 0) {
+		cf.a76 = a76;
+	}
+	if (!error && a55 != cf.a55 && (error = cf_set_pll(CPUPLL_A55, cf_a55[a55].mhz, "A55")) == 0) {
+		cf.a55 = a55;
+	}
+	if (!error && dsu != cf.dsu && (error = cf_set_pll(CPUPLL_DSU, cf_dsu[dsu].mhz, "DSU")) == 0) {
+		cf.dsu = dsu;
+	}
+	if (error) {
+		return error;                   /* keep the higher voltage */
+	}
+	if (w3 < cf.v3) {
+		error = cf_set_mv(AXP8191_DC3_VOL, w3, &cf.v3);
+	}
+	if (!error && w5 < cf.v5) {
+		error = cf_set_mv(AXP8191_DC5_VOL, w5, &cf.v5);
+	}
+	return error;
+}
+
+static bool
+ths_init(void)
+{
+	uint32_t cal[3];
+	wr32(cf.ccu, CCU_GPADC0_24M, (rd32(cf.ccu, CCU_GPADC0_24M) & ~((7u << 24) | 0x1fu)) | (1u << 31));
+	wr32(cf.ccu, CCU_GPADC0_BGR, rd32(cf.ccu, CCU_GPADC0_BGR) | (1u << 16) | 1u);
+	wr32(cf.ccu, CCU_THS0_BGR, rd32(cf.ccu, CCU_THS0_BGR) | (1u << 16) | 1u);
+	delay(50);
+	for (unsigned i = 0; i < 3; i++) {
+		cal[i] = rd32(cf.sid, SID_THS_CAL + 4 * i);
+	}
+	unsigned calibrated = 0;
+	for (unsigned i = 0; i < THS_SENSORS; i++) {
+		uint32_t cdata;
+		if (ths_calib(cal, i, &cdata) == 0) {
+			uint32_t o = THS_CALIB + (i / 2) * 4, sh = (i % 2) * 16;
+			wr32(cf.ths, o, (rd32(cf.ths, o) & ~(0xfffu << sh)) | (cdata << sh));
+			calibrated++;
+		}
+	}
+	/* sun60iw2_thermal_init() */
+	wr32(cf.ths, THS_CTRL0, 47u | (479u << 16));
+	wr32(cf.ths, THS_MFC, (1u << 2) | 1u);
+	wr32(cf.ths, THS_PC, 28u << 12);
+	wr32(cf.ths, THS_DATA_INTS, 0x1f);
+	wr32(cf.ths, THS_ENABLE, 0x1f);
+	printf("A733 THERMAL: THS on, efuse calibration 0x%08x 0x%08x 0x%08x (%u/%u sensors)\n",
+	    cal[0], cal[1], cal[2], calibrated, THS_SENSORS);
+	return true;
+}
+
+/* Hottest sensor in millidegrees, or CF_NO_TEMP without data. */
+static int
+ths_max_mc(void)
+{
+	int best = CF_NO_TEMP;
+	uint32_t ints = rd32(cf.ths, THS_DATA_INTS);
+	for (unsigned i = 0; i < THS_SENSORS; i++) {
+		uint32_t v = rd32(cf.ths, THS_DATA + 4 * i) & 0xfff;
+		if (v && (ints & (1u << i))) {
+			int mc = ths_mc((int)v);
+			best = mc > best ? mc : best;
+		}
+	}
+	return best;
+}
+
+static void
+cf_init(void)
+{
+	uint32_t level = 3;
+	PE_parse_boot_argn("a733cpufreq", &level, sizeof(level));
+	if (!cf.sid || !pw.cpupll || level == 0) {
+		printf("A733 CPUFREQ: off (a733cpufreq=%u)\n", level);
+		return;
+	}
+	uint32_t word = rd32(cf.sid, SID_DVFS);
+	cf.col = cf_column(word, &cf.index);
+	uint16_t max_mv = level == 1 ? 800 : level == 2 ? 950 : CF_MAX_MV;
+	uint8_t ctl = 0;
+	if (cf.col < 0 || cf_read_mv(AXP8191_DC3_VOL, &cf.v3) || cf_read_mv(AXP8191_DC5_VOL, &cf.v5) ||
+	    twi_read(AXP8191_ADDR, AXP8191_DCDC_CTL1, &ctl) || (ctl & 0x14) != 0x14) {
+		printf("A733 CPUFREQ: efuse 0x%08x column %d, PMIC rails unreadable or off (ctl 0x%02x); off\n",
+		    word, cf.col, ctl);
+		cf.col = -1;
+		return;
+	}
+	cf.a76_max = cf_pick(cf_a76, CF_N(cf_a76), cf.col, max_mv, CF_FLOOR_MHZ, 2256);
+	cf.a55_max = cf_pick(cf_a55, CF_N(cf_a55), cf.col, max_mv, CF_FLOOR_MHZ, 2256);
+	int dsu = cf_pick(cf_dsu, CF_N(cf_dsu), cf.col, max_mv, 672, 2256);
+	if (cf.a76_max < 0 || cf.a55_max < 0 || dsu < 0) {
+		printf("A733 CPUFREQ: no OPP for column %d at %u mV; off\n", cf.col, max_mv);
+		cf.col = -1;
+		return;
+	}
+	printf("A733 CPUFREQ: efuse 0x%08x -> vf%04x (column %d), level %u (<= %u mV): A76 %u MHz %u mV, "
+	    "A55 %u MHz %u mV, DSU %u MHz; rails now DCDC3 %u mV, DCDC5 %u mV\n",
+	    word, cf.index, cf.col, level, max_mv, cf_a76[cf.a76_max].mhz, cf_a76[cf.a76_max].mv[cf.col],
+	    cf_a55[cf.a55_max].mhz, cf_a55[cf.a55_max].mv[cf.col], cf_dsu[dsu].mhz, cf.v3, cf.v5);
+	int error = cf_apply(cf.a76_max, cf.a55_max, dsu);
+	printf("A733 CPUFREQ: %s\n", error ? "stopped (see above)" : "done");
+	pw_cpu_report();
+	cf_sync();
+}
+
+/* Once a second: step both clusters one row down when hot, back up when cool. */
+static void
+cf_thermal_tick(void)
+{
+	int mc = ths_max_mc();
+	if (mc == CF_NO_TEMP) {
+		return;
+	}
+	int act = cf_thermal_action(mc), a76 = cf.a76, a55 = cf.a55;
+	if (cf.col >= 0 && cf.a76 >= 0 && cf.a55 >= 0 && cf.dsu >= 0) {
+		int f76 = cf_pick(cf_a76, CF_N(cf_a76), cf.col, CF_MAX_MV, CF_FLOOR_MHZ, CF_FLOOR_MHZ);
+		int f55 = cf_pick(cf_a55, CF_N(cf_a55), cf.col, CF_MAX_MV, CF_FLOOR_MHZ, CF_FLOOR_MHZ);
+		if (act == CF_FLOOR) {
+			a76 = f76 >= 0 ? f76 : a76;
+			a55 = f55 >= 0 ? f55 : a55;
+		} else if (act != CF_HOLD) {
+			a76 = cf_step(cf_a76, CF_N(cf_a76), cf.col, cf.a76, act, CF_FLOOR_MHZ, cf.a76_max);
+			a55 = cf_step(cf_a55, CF_N(cf_a55), cf.col, cf.a55, act, CF_FLOOR_MHZ, cf.a55_max);
+		}
+		if (a76 != cf.a76 || a55 != cf.a55) {
+			printf("A733 THERMAL: %d.%d C -> A76 %u MHz, A55 %u MHz\n", mc / 1000, (mc % 1000) / 100,
+			    cf_a76[a76].mhz, cf_a55[a55].mhz);
+			(void)cf_apply(a76, a55, cf.dsu);
+		}
+	}
+	if (cf.last_mc == 0 || mc - cf.last_mc >= 5000 || cf.last_mc - mc >= 5000) {
+		cf.last_mc = mc;
+		printf("A733 THERMAL: %d.%d C, A76 %u MHz, A55 %u MHz\n", mc / 1000, (mc % 1000) / 100,
+		    cf.a76 >= 0 ? cf_a76[cf.a76].mhz : 0, cf.a55 >= 0 ? cf_a55[cf.a55].mhz : 0);
+	}
+}
+
+static void
+pw_shutdown(void)
+{
+	static char msg[] = "A733 power button: triple press";
+	printf("A733 POWER: triple press: clean shutdown (stop processes, sync, unmount, power off)\n");
+	(void)a733_sd_log_sync();
+	int error = reboot_kernel(RB_HALT, msg);
+	printf("A733 POWER: reboot_kernel returned %d\n", error);
+}
