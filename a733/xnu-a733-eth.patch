+/* sunxi-gmac-210 syscon (dwmac-sunxi.h): RGMII, TX clock source, delay chains. */
+#define SYSCON_EPIT             (1u << 2)
+#define SYSCON_ETCS_EXT         1u
+#define SYSCON_ETCS_INT         2u
+
+static uint32_t
+eth_syscon(uint32_t tx_delay, uint32_t rx_delay, bool clk_ext)
+{
+	uint32_t v = SYSCON_EPIT | (clk_ext ? SYSCON_ETCS_EXT : SYSCON_ETCS_INT);
+	v |= ((tx_delay >> 3) & 3u) << 16;      /* ETXDC_H */
+	v |= (tx_delay & 7u) << 10;             /* ETXDC_L */
+	v |= (rx_delay & 31u) << 5;             /* ERXDC */
+	return v;
+}
+
+/*
+ * Motorcomm YT8531 (id 4f51:e91b, the PHY on this board) SyncE / CLK_OUT,
+ * extended register 0xA012 (Linux drivers/net/phy/motorcomm.c): enable bit 6,
+ * 125 MHz select bit 4 (reset default 25 MHz), source bits 3:1 (0 = PLL 125M).
+ * With aw,rgmii-clk-ext the MAC takes its RGMII TX reference from that pin.
+ */
+#define YT8531_PHY_ID1          0x4f51
+#define YT8531_SYNCE_CFG        0xa012
+#define YT8531_SCR_ENABLE       (1u << 6)
+#define YT8531_SCR_125M         (1u << 4)
+#define YT8531_SCR_SRC_MASK     (7u << 1)
+#define YT8531_SLEEP_CTRL1      0x0027
+#define YT8531_SLEEP_SW         (1u << 15)
+#define YT8531_LED1_CFG         0xa00d
+#define YT8531_LED2_CFG         0xa00e
+#define YT8531_LED_BLINK_CFG    0xa00f
+
+static uint16_t
+yt8531_clkout(uint16_t old, bool m125)
+{
+	uint16_t v = (uint16_t)(old & ~(YT8531_SCR_ENABLE | YT8531_SCR_125M | YT8531_SCR_SRC_MASK));
+	v |= YT8531_SCR_ENABLE;                 /* source 0: PLL 125M */
+	if (m125) {
+		v |= YT8531_SCR_125M;
+	}
+	return v;
+}
