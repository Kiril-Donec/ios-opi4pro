+/* A stable, locally administered unicast MAC from the SoC chip ID. */
+static void
+eth_mac_from_chipid(const uint32_t id[4], uint8_t mac[6])
+{
+	uint32_t h = 2166136261u;
+	for (unsigned i = 0; i < 16; i++) {
+		h = (h ^ ((id[i / 4] >> (8 * (i % 4))) & 0xff)) * 16777619u;
+	}
+	uint32_t h2 = (h ^ id[0] ^ (id[3] << 7)) * 2654435761u;
+	mac[0] = 0x02;                          /* locally administered, unicast */
+	mac[1] = (uint8_t)(h >> 24);
+	mac[2] = (uint8_t)(h >> 16);
+	mac[3] = (uint8_t)(h >> 8);
+	mac[4] = (uint8_t)h2;
+	mac[5] = (uint8_t)(h2 >> 8);
+}
+
+static uint16_t
+ip_csum(const uint8_t *p, unsigned len)
+{
+	uint32_t s = 0;
+	for (unsigned i = 0; i + 1 < len; i += 2) {
+		s += (uint32_t)(p[i] << 8 | p[i + 1]);
+	}
+	if (len & 1) {
+		s += (uint32_t)p[len - 1] << 8;
+	}
+	while (s >> 16) {
+		s = (s & 0xffff) + (s >> 16);
+	}
+	return (uint16_t)~s;
+}
+
+#define DHCP_DISCOVER   1
+#define DHCP_OFFER      2
+#define DHCP_REQUEST    3
+#define DHCP_ACK        5
+#define DHCP_NAK        6
+#define DHCP_FRAME_MAX  400
+
+static void
+put16(uint8_t *p, uint16_t v)
+{
+	p[0] = (uint8_t)(v >> 8);
+	p[1] = (uint8_t)v;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+	p[0] = (uint8_t)(v >> 24);
+	p[1] = (uint8_t)(v >> 16);
+	p[2] = (uint8_t)(v >> 8);
+	p[3] = (uint8_t)v;
+}
+
+static uint32_t
+get32(const uint8_t *p)
+{
+	return (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 | (uint32_t)p[2] << 8 | p[3];
+}
+
+/*
+ * Broadcast DHCP DISCOVER / REQUEST as a full Ethernet frame (IPv4 0.0.0.0 ->
+ * 255.255.255.255, UDP 68 -> 67). req_ip / server only for REQUEST.
+ * Returns the frame length (<= DHCP_FRAME_MAX).
+ */
+static unsigned
+dhcp_build(uint8_t *f, const uint8_t mac[6], uint32_t xid, int type, uint32_t req_ip, uint32_t server)
+{
+	memset(f, 0, DHCP_FRAME_MAX);
+	memset(f, 0xff, 6);
+	memcpy(f + 6, mac, 6);
+	put16(f + 12, 0x0800);
+	uint8_t *ip = f + 14, *udp = ip + 20, *b = udp + 8;
+	b[0] = 1;                               /* BOOTREQUEST */
+	b[1] = 1;                               /* Ethernet */
+	b[2] = 6;
+	put32(b + 4, xid);
+	put16(b + 10, 0x8000);                  /* broadcast reply */
+	memcpy(b + 28, mac, 6);
+	put32(b + 236, 0x63825363);             /* magic cookie */
+	uint8_t *o = b + 240;
+	*o++ = 53; *o++ = 1; *o++ = (uint8_t)type;
+	*o++ = 61; *o++ = 7; *o++ = 1; memcpy(o, mac, 6); o += 6;
+	*o++ = 12; *o++ = 11; memcpy(o, "iPhone-A733", 11); o += 11;
+	*o++ = 55; *o++ = 4; *o++ = 1; *o++ = 3; *o++ = 6; *o++ = 15;
+	if (type == DHCP_REQUEST) {
+		*o++ = 50; *o++ = 4; put32(o, req_ip); o += 4;
+		*o++ = 54; *o++ = 4; put32(o, server); o += 4;
+	}
+	*o++ = 255;
+	unsigned blen = (unsigned)(o - b);
+	if (blen < 300) {
+		blen = 300;                     /* BOOTP minimum */
+	}
+	unsigned udp_len = 8 + blen, ip_len = 20 + udp_len;
+	ip[0] = 0x45;
+	put16(ip + 2, (uint16_t)ip_len);
+	put16(ip + 4, (uint16_t)xid);
+	ip[8] = 64;
+	ip[9] = 17;
+	put32(ip + 12, 0);
+	put32(ip + 16, 0xffffffff);
+	put16(ip + 10, ip_csum(ip, 20));
+	put16(udp, 68);
+	put16(udp + 2, 67);
+	put16(udp + 4, (uint16_t)udp_len);      /* UDP checksum 0: none (IPv4) */
+	return 14 + ip_len;
+}
+
+struct dhcp_reply {
+	int type;
+	uint32_t yiaddr, server, mask, router, lease;
+};
+
+/* A DHCP reply to us (xid) in an Ethernet frame: its type, or 0 if not one. */
+static int
+dhcp_parse(const uint8_t *f, unsigned len, uint32_t xid, struct dhcp_reply *r)
+{
+	memset(r, 0, sizeof(*r));
+	if (len < 14 + 20 + 8 + 240 || f[12] != 0x08 || f[13] != 0x00) {
+		return 0;
+	}
+	const uint8_t *ip = f + 14;
+	unsigned ihl = (ip[0] & 15u) * 4;
+	if ((ip[0] >> 4) != 4 || ihl < 20 || ip[9] != 17 || 14 + ihl + 8 + 240 > len) {
+		return 0;
+	}
+	const uint8_t *udp = ip + ihl, *b = udp + 8;
+	if (((udp[2] << 8) | udp[3]) != 68 || b[0] != 2 || get32(b + 4) != xid || get32(b + 236) != 0x63825363) {
+		return 0;
+	}
+	r->yiaddr = get32(b + 16);
+	const uint8_t *o = b + 240, *end = f + len;
+	while (o < end && *o != 255) {
+		if (*o == 0) {
+			o++;
+			continue;
+		}
+		if (o + 2 > end || o + 2 + o[1] > end) {
+			break;
+		}
+		uint8_t code = o[0], l = o[1];
+		const uint8_t *v = o + 2;
+		if (code == 53 && l >= 1) {
+			r->type = v[0];
+		} else if (code == 54 && l >= 4) {
+			r->server = get32(v);
+		} else if (code == 1 && l >= 4) {
+			r->mask = get32(v);
+		} else if (code == 3 && l >= 4) {
+			r->router = get32(v);
+		} else if (code == 51 && l >= 4) {
+			r->lease = get32(v);
+		}
+		o += 2 + l;
+	}
+	return r->type;
+}
