+		uint8_t want = ctl | AXP8191_DC1SW1 | AXP8191_DC1SW2;
+		if (rc == 0 && want != ctl) {
+			rc = twi_write(AXP8191_ADDR, AXP8191_DCDC_CTL2, want);
+		}
+		printf("A733 POWER: Ethernet rails DC1SW1/DC1SW2: 0x%02x -> 0x%02x%s\n", ctl, want, rc ? " FAILED" : "");
+		a733_eth_power = rc ? -1 : 1;
+	} else {
+		a733_eth_power = -1;
+	}
 	if (!pw.have[0] && !pw.have[1]) {
 		printf("A733 POWER: no PMIC on R_TWI0; power button off\n");
