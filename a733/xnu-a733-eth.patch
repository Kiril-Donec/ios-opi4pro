+/*
+ * TX clocking variants tried in turn while DHCP gets no answer (board test #17:
+ * RX fine, nothing we sent was answered). 0 is the vendor Linux setup.
+ */
+struct eth_variant {
+	bool clk_ext;           /* syscon ETCS external (PHY CLK_OUT) or internal */
+	bool phy125;            /* PHY CLK_OUT 125 MHz (else 25 MHz) */
+	int tx_delay;           /* -1: board DT value */
+};
+
+static const struct eth_variant eth_variants[] = {
+	{ true, true, -1 },
+	{ false, true, -1 },
+	{ true, true, 0 },
+	{ false, true, 0 },
+	{ true, false, -1 },    /* the test #17 setup, for comparison */
+};
+#define ETH_VARIANTS            (sizeof(eth_variants) / sizeof(eth_variants[0]))
+#define ETH_VARIANT_TRIES       6       /* DISCOVERs (3 s apart) before the next variant */
+
+/*
+ * RGMII delay calibration through PHY loopback (board test #18: with the PHY
+ * RX delay off RX had ~55 % CRC errors at 100 Mbit/s, and no TX setting got a
+ * DHCP answer). Every (TX delay, RX delay) point of the syscon delay chains
+ * sends LB_FRAMES frames that the PHY loops back; the point used is the passing
+ * one farthest from any failing point.
+ */
+#define LB_FRAMES               4
+static const uint8_t lb_txd[] = { 0, 3, 6, 9, 12, 15, 18, 21, 24, 27, 31 };
+static const uint8_t lb_rxd[] = { 0, 3, 6, 10, 13, 16, 19, 22, 25, 28, 31 };
+#define LB_NT                   (sizeof(lb_txd) / sizeof(lb_txd[0]))
+#define LB_NR                   (sizeof(lb_rxd) / sizeof(lb_rxd[0]))
+
+/* score[t][r] = frames back intact; picks the passing cell with the largest Chebyshev distance to a failure. */
+static bool
+lb_pick(const uint8_t score[LB_NT][LB_NR], unsigned *bt, unsigned *br)
+{
+	int best = -1;
+	unsigned best_c = 0;
+	for (unsigned t = 0; t < LB_NT; t++) {
+		for (unsigned r = 0; r < LB_NR; r++) {
+			if (score[t][r] != LB_FRAMES) {
+				continue;
+			}
+			int d = 1000;
+			for (unsigned t2 = 0; t2 < LB_NT; t2++) {
+				for (unsigned r2 = 0; r2 < LB_NR; r2++) {
+					if (score[t2][r2] == LB_FRAMES) {
+						continue;
+					}
+					int dt = (int)t2 - (int)t, dr = (int)r2 - (int)r;
+					dt = dt < 0 ? -dt : dt;
+					dr = dr < 0 ? -dr : dr;
+					int c = dt > dr ? dt : dr;
+					if (c < d) {
+						d = c;
+					}
+				}
+			}
+			/* ties: closer to the middle of the grid */
+			int mt = 2 * (int)t - (int)(LB_NT - 1), mr = 2 * (int)r - (int)(LB_NR - 1);
+			unsigned centre = (unsigned)(mt * mt + mr * mr);
+			if (d > best || (d == best && centre < best_c)) {
+				best = d;
+				best_c = centre;
+				*bt = t;
+				*br = r;
+			}
+		}
+	}
+	return best >= 0;
+}
+
+/* Clause 22: link speed/duplex from BMSR, ANAR, ANLPAR, 1000BASE-T control/status. */
+static bool
+eth_phy_resolve(uint16_t bmsr, uint16_t anar, uint16_t anlpar, uint16_t gctl, uint16_t gsts,
+    unsigned *speed, bool *full)
+{
+	if (!(bmsr & (1u << 2))) {              /* link status */
+		return false;
+	}
+	if ((gctl & (1u << 9)) && (gsts & (1u << 11))) {
+		*speed = 1000;
+		*full = true;
+	} else if ((gctl & (1u << 8)) && (gsts & (1u << 10))) {
+		*speed = 1000;
+		*full = false;
+	} else {
+		uint16_t common = anar & anlpar;
+		if (common & (1u << 8)) {
+			*speed = 100;
+			*full = true;
+		} else if (common & (1u << 7)) {
+			*speed = 100;
+			*full = false;
+		} else if (common & (1u << 6)) {
+			*speed = 10;
+			*full = true;
+		} else {
+			*speed = 10;
+			*full = false;
+		}
+	}
+	return true;
+}
