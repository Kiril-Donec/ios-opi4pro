+/*
+ * Allwinner A733 / Orange Pi 4 Pro gigabit Ethernet (gmac0), first stage.
+ *
+ * gmac0 is a Synopsys DesignWare Ethernet QoS 5.20 ("snps,dwmac-5.20", the
+ * Linux stmmac/dwmac4 core) at 0x04500000 with the Allwinner glue
+ * "allwinner,sunxi-gmac-210" (syscon at 0x04508000: RGMII, external TX
+ * clock, delay chains; vendor bsp/drivers/stmmac/dwmac-sunxi.c). The PHY
+ * (JLSemi, MDIO address 1) gets its 25 MHz reference from the SoC
+ * (aw,soc-phy-clk-en) and its 3.3 V from AXP8191 DC1SW1 (DC1SW2 powers the
+ * PH pins); a733_power.c switches those rails on.
+ *
+ * This stage: clocks, resets, PH0-PH15 as rgmii0, syscon, MDIO + clause-22
+ * autonegotiation, one TX and one RX DMA ring in a low-memory window from the
+ * ADT ("dma-reg", 32-bit addresses; XNU's RAM is above 4 GiB), polled from a
+ * thread (no interrupts), a BSD Ethernet ifnet, and a small DHCP client in
+ * the kernel that configures the interface's IPv4 address, so the board
+ * answers ping on the LAN. iOS itself does not see the interface yet (that
+ * needs an IOKit network interface for configd).
+ *
+ * Boot-args: a733eth=0 off, a733eth_unit=N (interface en<N>, default 3).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(A733_ETH_HOST_TEST)
+
