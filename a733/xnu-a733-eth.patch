+/*
+ * Ethernet for iOS (a733_eth.c attaches the bare BSD interface en3; there is no
+ * IOKit network interface, so configd never creates a service for it). A
+ * SystemConfiguration preferences.plist with one Ethernet service on en3, IPv4
+ * by DHCP: PreferencesMonitor publishes it as Setup:, IPConfiguration runs DHCP
+ * on en3 and IPMonitor makes it the primary service (default route, DNS for
+ * mDNSResponder). Layout as written by SCPreferences (configd-1241.140.6);
+ * __VERSION__ = NETWORK_CONFIGURATION_VERSION so no upgrade/clean pass runs, and
+ * no Model key so PreferencesMonitor does not archive it as "other hardware".
+ * Written whole once (own marker); boot-arg a733netprefs=0 off, =2 rewrite.
+ */
+#define NP_DIR          "/private/var/preferences/SystemConfiguration"
+#define NP_FILE         NP_DIR "/preferences.plist"
+#define NP_MARKER       "/private/var/root/.a733-netprefs-v1"
+#define NP_SERVICE      "A7330E73-0000-4000-8000-0000000000E3"
+#define NP_SET          "A7330E73-0000-4000-8000-00000000005E"
+
+static const char np_body[] =
+    "\t<key>CurrentSet</key>\n\t<string>/Sets/" NP_SET "</string>\n"
+    "\t<key>NetworkServices</key>\n\t<dict>\n"
+    "\t\t<key>" NP_SERVICE "</key>\n\t\t<dict>\n"
+    "\t\t\t<key>DNS</key>\n\t\t\t<dict/>\n"
+    "\t\t\t<key>IPv4</key>\n\t\t\t<dict>\n"
+    "\t\t\t\t<key>ConfigMethod</key>\n\t\t\t\t<string>DHCP</string>\n"
+    "\t\t\t</dict>\n"
+    "\t\t\t<key>Interface</key>\n\t\t\t<dict>\n"
+    "\t\t\t\t<key>DeviceName</key>\n\t\t\t\t<string>en3</string>\n"
+    "\t\t\t\t<key>Hardware</key>\n\t\t\t\t<string>Ethernet</string>\n"
+    "\t\t\t\t<key>Type</key>\n\t\t\t\t<string>Ethernet</string>\n"
+    "\t\t\t\t<key>UserDefinedName</key>\n\t\t\t\t<string>Ethernet</string>\n"
+    "\t\t\t</dict>\n"
+    "\t\t\t<key>Proxies</key>\n\t\t\t<dict/>\n"
+    "\t\t\t<key>UserDefinedName</key>\n\t\t\t<string>Ethernet</string>\n"
+    "\t\t</dict>\n"
+    "\t</dict>\n"
+    "\t<key>Sets</key>\n\t<dict>\n"
+    "\t\t<key>" NP_SET "</key>\n\t\t<dict>\n"
+    "\t\t\t<key>Network</key>\n\t\t\t<dict>\n"
+    "\t\t\t\t<key>Global</key>\n\t\t\t\t<dict>\n"
+    "\t\t\t\t\t<key>IPv4</key>\n\t\t\t\t\t<dict>\n"
+    "\t\t\t\t\t\t<key>ServiceOrder</key>\n\t\t\t\t\t\t<array>\n"
+    "\t\t\t\t\t\t\t<string>" NP_SERVICE "</string>\n"
+    "\t\t\t\t\t\t</array>\n"
+    "\t\t\t\t\t</dict>\n"
+    "\t\t\t\t</dict>\n"
+    "\t\t\t\t<key>Service</key>\n\t\t\t\t<dict>\n"
+    "\t\t\t\t\t<key>" NP_SERVICE "</key>\n\t\t\t\t\t<dict>\n"
+    "\t\t\t\t\t\t<key>__LINK__</key>\n"
+    "\t\t\t\t\t\t<string>/NetworkServices/" NP_SERVICE "</string>\n"
+    "\t\t\t\t\t</dict>\n"
+    "\t\t\t\t</dict>\n"
+    "\t\t\t</dict>\n"
+    "\t\t\t<key>UserDefinedName</key>\n\t\t\t<string>Automatic</string>\n"
+    "\t\t</dict>\n"
+    "\t</dict>\n"
+    "\t<key>__VERSION__</key>\n\t<integer>20191120</integer>\n";
+
+static void
+fb_netprefs(void)
+{
+	uint32_t mode = 1;
+	PE_parse_boot_argn("a733netprefs", &mode, sizeof(mode));
+	if (mode == 0) {
+		return;
+	}
+	if (mode != 2 && fb_exists(NP_MARKER)) {
+		printf("A733 NETPREFS: done before (%s)\n", NP_MARKER);
+		return;
+	}
+	if (!fb_exists("/private/var/preferences")) {
+		printf("A733 NETPREFS: /private/var/preferences missing, not an iOS root; skipped\n");
+		return;
+	}
+	bool had = fb_exists(NP_FILE);
+	int error = fb_mkdir(NP_DIR, 0);
+	if (!error) {
+		error = fb_write(NP_FILE, FB_HEAD, np_body, FB_TAIL, 0, 0644);
+	}
+	printf("A733 NETPREFS: %s Ethernet service on en3 (DHCP) %s (%d)\n", NP_FILE,
+	    error ? "FAILED" : had ? "written over configd's" : "written", error);
+	if (!error) {
+		error = fb_write(NP_MARKER, "", "A733 network preferences v1 (Ethernet en3, DHCP)\n", "", 0, 0644);
+		printf("A733 NETPREFS: marker %s (%d)\n", error ? "FAILED" : "written", error);
+	}
+}
