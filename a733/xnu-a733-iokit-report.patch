diff --git a/iokit/Kernel/arm/A733IOKitReport.cpp b/iokit/Kernel/arm/A733IOKitReport.cpp
new file mode 100644
index 0000000..4f11cd8
--- /dev/null
+++ b/iokit/Kernel/arm/A733IOKitReport.cpp
@@ -0,0 +1,69 @@
+/*
+ * A733: report of IOKit services that are still busy.
+ *
+ * configd's InterfaceNamer and SystemConfiguration (_SCNetworkInterface*,
+ * Settings > General > About) wait until IOKit is quiet, i.e. until no
+ * service is busy any more (matching, probe/start or termination still
+ * running; IOService::waitQuiet on the root). Board test #15 hung there, so
+ * something on this kernel never finishes. a733_power.c calls this one and
+ * three minutes after boot: every busy service is logged with its class,
+ * state bits and provider, deepest first in each branch, so the leaf that
+ * keeps its parents busy is the one to fix.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IOLib.h>
+
+extern "C" void a733_iokit_busy_report(unsigned int seconds);
+
+void
+a733_iokit_busy_report(unsigned int seconds)
+{
+	IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	unsigned int busy = 0, shown = 0, total = 0;
+	if (it == NULL) {
+		IOLog("A733 IOKIT: no registry iterator\n");
+		return;
+	}
+	IORegistryEntry *entry;
+	while ((entry = it->getNextObject()) != NULL) {
+		IOService *s = OSDynamicCast(IOService, entry);
+		if (s == NULL) {
+			continue;
+		}
+		total++;
+		UInt32 b = s->getBusyState();
+		if (b == 0) {
+			continue;
+		}
+		busy++;
+		/* A leaf: busy itself, not only because a child is. */
+		bool leaf = true;
+		OSIterator *kids = s->getChildIterator(gIOServicePlane);
+		if (kids != NULL) {
+			OSObject *k;
+			while ((k = kids->getNextObject()) != NULL) {
+				IOService *c = OSDynamicCast(IOService, k);
+				if (c != NULL && c->getBusyState() != 0) {
+					leaf = false;
+					break;
+				}
+			}
+			kids->release();
+		}
+		if (shown < 48) {
+			shown++;
+			IOService *p = s->getProvider();
+			IOLog("A733 IOKIT: %s busy %u %s <%s> state 0x%x provider %s <%s>\n", leaf ? "LEAF" : "    ", b,
+			    s->getName(), s->getMetaClass()->getClassName(), (unsigned int)s->getState(),
+			    p ? p->getName() : "-", p ? p->getMetaClass()->getClassName() : "-");
+		}
+	}
+	it->release();
+	IOLog("A733 IOKIT: %u s after boot: %u of %u services busy%s\n", seconds, busy, total,
+	    busy ? " (LEAF lines are the ones that keep IOKit from quiescing)" : ", IOKit is quiet");
+}
+#endif /* SWEET */
