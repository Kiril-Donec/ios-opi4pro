 static uint32_t fbcon_cols, fbcon_rows, fbcon_col, fbcon_row;
 
+/* A733: keep recent kernel output as a debug layer over REAL iOS frames. */
+#define A733_LOG_ROWS 8
+#define A733_LOG_COLS 72
+static char a733_log_lines[A733_LOG_ROWS][A733_LOG_COLS];
+static uint32_t a733_log_row, a733_log_col;
+static void
+a733_log_newline(void)
+{
+	a733_log_col = 0;
+	a733_log_row = (a733_log_row + 1) % A733_LOG_ROWS;
+	for (uint32_t i = 0; i < A733_LOG_COLS; i++) {
+		a733_log_lines[a733_log_row][i] = 0;
+	}
+}
