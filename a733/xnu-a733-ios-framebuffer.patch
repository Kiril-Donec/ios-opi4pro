+/* Overlay the last eight kernel log lines over an actual Apple IOSurface. */
+void
+a733_fbcon_overlay(void)
+{
+	if (fbcon_base == NULL || fbcon_height != 600 || fbcon_width != 1024 ||
+	    fbcon_stride != 4096) {
+		return;
+	}
+	const uint32_t y0 = 1024 - (A733_LOG_ROWS * 16 + 8);
+	const uint32_t stride = fbcon_stride / 4;
+	/* Darken the existing iOS frame; retain some visible pixels underneath. */
+	for (uint32_t y = y0; y < 1024; y++) {
+		for (uint32_t x = 0; x < 600; x++) {
+			uint32_t off = (599u - x) * stride + y;
+			uint32_t color = fbcon_base[off];
+			fbcon_base[off] = 0xff000000u | ((color & 0xfefefeu) >> 1);
+		}
+	}
+	for (uint32_t r = 0; r < A733_LOG_ROWS; r++) {
+		uint32_t line = (a733_log_row + 1 + r) % A733_LOG_ROWS;
+		for (uint32_t col = 0; col < A733_LOG_COLS; col++) {
+			unsigned char c = (unsigned char)a733_log_lines[line][col];
+			if (c < 32 || c > 126) {
+				continue;
+			}
+			const unsigned char *glyph = iso_font + c * 16;
+			for (uint32_t gy = 0; gy < 16; gy++) {
+				for (uint32_t gx = 0; gx < 8; gx++) {
+					if (glyph[gy] & (1u << gx)) {
+						fbcon_portrait_pixel(12 + col * 8 + gx,
+						    y0 + r * 16 + gy, 0xffffffffu);
+					}
+				}
+			}
+		}
+	}
+}
