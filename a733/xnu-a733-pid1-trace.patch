diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6825,11 +6825,20 @@
 
 	/*
 	 * So that init task is set with uid,gid 0 token
 	 */
-	set_security_token(p);
-
-	return execve(p, &init_exec_args, retval);
+	set_security_token(p);
+
+#if defined(SWEET)
+	/* A733 PID1: report completion of exec, independently of /dev/console.
+	 * A zero errno means the Mach-O was accepted, NOT that user code ran. */
+	kprintf("A733 PID1: execve entering for %s\n", path);
+#endif
+	error = execve(p, &init_exec_args, retval);
+#if defined(SWEET)
+	kprintf("A733 PID1: execve returned errno=%d for %s\n", error, path);
+#endif
+	return error;
 }
 
