diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -34,7 +34,9 @@
 #define __ARM_DEBUG__             7
 #define __ARM_ENABLE_SWAP__       1
 #define __ARM_V8_CRYPTO_EXTENSIONS__ 1
-/* topaz: Cortex-A53/A73 have no PAN (ARMv8.1); MSR PAN is undefined there */
+/* A733 only: Cortex-A76 (ARMv8.2) implements PAN; old A53/A73 did not.
+ * XNU must explicitly set PAN on EL1 entry and clear it for copyio. */
+#define __ARM_PAN_AVAILABLE__    1
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
diff --git a/osfmk/arm64/copyio.c b/osfmk/arm64/copyio.c
--- a/osfmk/arm64/copyio.c
+++ b/osfmk/arm64/copyio.c
@@ -328,20 +328,17 @@
 	if (__improbable(result)) {
 		return result;
 	}
 #if defined(SWEET)
-	kprintf("A733 PID1 V16: COPYINSTR_USER_ACCESS_ENTER\n");
+	kprintf("A733 PID1 V17: COPYINSTR_ACCESS_BEGIN\n");
 #endif
 	user_access_enable();
-#if defined(SWEET)
-	kprintf("A733 PID1 V16: COPYINSTR_ASM_ENTER\n");
-#endif
 	result = _bcopyinstr((const char *)user_addr, kernel_addr, nbytes,
 	    &bytes_copied);
-#if defined(SWEET)
-	kprintf("A733 PID1 V16: COPYINSTR_ASM_DONE errno=%d len=%lu\n",
-	    result, (unsigned long)bytes_copied);
-#endif
 	user_access_disable();
+#if defined(SWEET)
+	kprintf("A733 PID1 V17: COPYINSTR_ACCESS_END errno=%d len=%lu\n",
+	    result, (unsigned long)bytes_copied);
+#endif
 	if (result != EFAULT) {
 		*lencopied = bytes_copied;
 	}
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -62,7 +62,7 @@
 MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=armv8.5a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
-# topaz: Cortex-A53/A73 are ARMv8.0 (no LSE atomics, RCpc, PAN or FP16). An explicit
+# A733: Cortex-A76 implements ARMv8.2 with PAN; compile for the boot CPU.
 # -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a76
 
 
