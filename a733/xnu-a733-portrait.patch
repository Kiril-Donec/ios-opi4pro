+/* Stage0 and HDMI timing stay 1024x600. This is the same rotation used by
+ * a733/src/display.c for DISPLAY_MONITOR_CLOCKWISE. */
+static void
+sweet_early_pixel(unsigned int x, unsigned int y, uint32_t color)
+{
+    if (x < EARLY_WIDTH && y < EARLY_HEIGHT) {
+        EARLY_FB[(EARLY_WIDTH - 1u - x) * EARLY_STRIDE + y] = color;
+    }
+}
+
+static void
+sweet_early_clear_screen(void)
+{
+    for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
+        for (unsigned int y = 0; y < EARLY_HEIGHT; y++) {
+            sweet_early_pixel(x, y, 0xff000000u);
+        }
+    }
+    __asm__ volatile("dsb sy" ::: "memory");
+}
