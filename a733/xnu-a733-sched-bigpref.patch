+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * A733: 2x Cortex-A76 + up to 6x Cortex-A55 in one SMP cluster (the kernel has
+ * no Edge scheduler and no CLPC to tell them apart). Interactive threads
+ * (user-initiated QoS and above) take an idle A76 first, background threads
+ * (utility and below) an idle A55, so UI work does not run on a slow core
+ * while a fast one is idle, and background work leaves the A76s free.
+ * Boot-arg a733bigpref=0 turns it off.
+ */
+static uint64_t sweet_big_mask;         /* logical CPUs that are A76 (MPIDR >= 0x600) */
+static int sweet_big_pref = -1;
+
+static uint64_t
+sweet_big_cpus(void)
+{
+	if (__improbable(sweet_big_pref < 0)) {
+		const ml_topology_info_t *topo = ml_get_topology_info();
+		uint64_t mask = 0;
+		for (unsigned int i = 0; i < topo->num_cpus; i++) {
+			if (topo->cpus[i].phys_id >= 0x600) {
+				mask |= 1ULL << topo->cpus[i].cpu_id;
+			}
+		}
+		int on = 1;
+		PE_parse_boot_argn("a733bigpref", &on, sizeof(on));
+		sweet_big_mask = mask;
+		/* Only useful with both kinds of core online. */
+		sweet_big_pref = (on && mask != 0 && (mask & ((1ULL << topo->num_cpus) - 1)) != ((1ULL << topo->num_cpus) - 1)) ? 1 : 0;
+	}
+	return sweet_big_pref ? sweet_big_mask : 0;
+}
+
+/* Preferred idle CPUs for this thread: big for interactive, little for background, 0 = any. */
+static uint64_t
+sweet_preferred(thread_t thread, uint64_t idle_map)
+{
+	uint64_t big = sweet_big_cpus();
+	if (big == 0) {
+		return 0;
+	}
+	if (thread->sched_pri >= BASEPRI_USER_INITIATED) {
+		return idle_map & big;
+	}
+	if (thread->sched_pri <= BASEPRI_UTILITY) {
+		return idle_map & ~big;
+	}
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
 processor_t
