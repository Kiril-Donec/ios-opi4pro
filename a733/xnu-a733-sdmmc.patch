+/*
+ * Allwinner A733 microSD root device (SMHC0), polled PIO, read-only.
+ *
+ * U-Boot loads our payload from this card, so the SMHC0 bus clock, reset,
+ * module clock, PF0-PF5 pin functions and pad voltage are already set up.
+ * This driver never writes the CCU or the pin controller: it only reads the
+ * SMHC0 clock register to know the module clock, soft-resets the controller,
+ * re-identifies the card (CMD0 .. ACMD6) and then reads 512-byte sectors
+ * through the FIFO with CMD17/CMD18, one command at a time, no IDMAC and no
+ * interrupts. A partition of the card (MBR or GPT, boot-arg sdpart=, default
+ * 2) is exposed as the BSD disk sdroot0 (rsdroot0); root on it with
+ * rd=sdroot0. Writes are refused.
+ *
+ * Register layout and clock rules follow the Orange Pi A733 vendor kernel
+ * (bsp/drivers/mmc/sunxi-mmc*.c, "allwinner,sunxi-mmc-v5p3x"), mainline
+ * Linux drivers/mmc/host/sunxi-mmc.c and U-Boot drivers/mmc/sunxi_mmc.c,
+ * whose PIO path this mirrors. CCU layout: ccu-sun60iw2.c (SMHC0 clock at
+ * CCU + 0xd00, bus gate / reset at CCU + 0xd0c).
+ *
+ * Boot-args: sdpart=N (1-based MBR/GPT index, default 2), sdforce=1 (accept
+ * a partition without an HFS+ volume header), sdclkdiv=N (override the
+ * transfer clock divider), sd4bit=0 (stay on a 1-bit bus).
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) || defined(A733_SD_HOST_TEST)
+
+#ifndef A733_SD_HOST_TEST
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+
+/* osfmk/arm/machine_routines.h, not exported to the BSD layer */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#ifndef EFTYPE
+#define EFTYPE 79
+#endif
+#endif /* !A733_SD_HOST_TEST */
