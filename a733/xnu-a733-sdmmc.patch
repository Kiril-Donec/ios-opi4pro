+static const struct cdevsw a733_sd_cdevsw = {
+	.d_open       = a733_sd_open,
+	.d_close      = a733_sd_close,
+	.d_read       = a733_sd_read,
+	.d_write      = a733_sd_write,
+	.d_ioctl      = a733_sd_cioctl,
