+
+static int
+a733_sd_init(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL, *ccu = NULL;
+	unsigned int size = 0, ccu_size = 0;
+	uint32_t idx = 2, force = 0, div_override = 0xffffffffu;
+	int error;
+
+	if (SecureDTLookupEntry(NULL, "/a733-sdmmc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t) ||
+	    SecureDTGetProperty(node, "ccu-reg", (void const **)&ccu, &ccu_size) != kSuccess ||
+	    ccu_size < 2 * sizeof(uintptr_t)) {
+		printf("A733 SD: no /a733-sdmmc node in the device tree (mkadt_a733.py --sdmmc)\n");
+		return ENXIO;
+	}
+	if (reg[1] < SMHC_MAP_SIZE || ccu[1] < CCU_MAP_SIZE) {
+		printf("A733 SD: device tree register windows too small\n");
+		return ENXIO;
+	}
+	PE_parse_boot_argn("sdpart", &idx, sizeof(idx));
+	PE_parse_boot_argn("sdforce", &force, sizeof(force));
+	PE_parse_boot_argn("sdclkdiv", &div_override, sizeof(div_override));
+
+	printf("A733 SD: mapping SMHC0 0x%lx and CCU 0x%lx\n", (unsigned long)reg[0], (unsigned long)ccu[0]);
+	sd.regs = ml_io_map(reg[0], SMHC_MAP_SIZE);
+	sd.ccu = ml_io_map(ccu[0], CCU_MAP_SIZE);
+	if (!sd.regs || !sd.ccu) {
+		return ENOMEM;
+	}
+
+	uint32_t clk = ccu_rd(CCU_SMHC0_CLK), bgr = ccu_rd(CCU_SMHC0_BGR);
+	printf("A733 SD: CCU SMHC0_CLK 0x%08x BGR 0x%08x\n", clk, bgr);
+	if ((bgr & (CCU_SMHC0_BGR_GATE | CCU_SMHC0_BGR_RESET)) != (CCU_SMHC0_BGR_GATE | CCU_SMHC0_BGR_RESET)) {
+		printf("A733 SD: SMHC0 bus clock gated or in reset; U-Boot did not leave it running\n");
+		return ENXIO;
+	}
+	sd.mod_hz = a733sd_ccu_mod_hz(clk);
+	if (sd.mod_hz == 0 || sd.mod_hz > SD_MOD_MAX_HZ) {
+		printf("A733 SD: unusable SMHC0 module clock (%llu Hz)\n", sd.mod_hz);
+		return ENXIO;
+	}
+	sd.ident_div = a733sd_pick_div(sd.mod_hz, SD_IDENT_HZ);
+	if (sd.ident_div > CLKCR_DIV_MASK) {
+		sd.ident_div = CLKCR_DIV_MASK;  /* 2x mode keeps it <= 400 kHz up to SD_MOD_MAX_HZ */
+	}
+	sd.xfer_div = a733sd_pick_div(sd.mod_hz, SD_DS_HZ);
+	if (div_override <= CLKCR_DIV_MASK) {
+		sd.xfer_div = div_override;
+	}
+	if (sd.xfer_div > CLKCR_DIV_MASK) {
+		sd.xfer_div = CLKCR_DIV_MASK;
+	}
+
+	printf("A733 SD: SMHC version 0x%x, GCTRL 0x%08x CLKCR 0x%08x NTSR 0x%08x STAS 0x%08x\n",
+	    smhc_rd(SMHC_VERS), smhc_rd(SMHC_GCTRL), smhc_rd(SMHC_CLKCR), smhc_rd(SMHC_NTSR),
+	    smhc_rd(SMHC_STAS));
+	printf("A733 SD: module clock %llu Hz; identification div %u (<= %llu Hz), transfer div %u (<= %llu Hz)\n",
+	    sd.mod_hz, sd.ident_div, a733sd_card_hz_max(sd.mod_hz, sd.ident_div),
+	    sd.xfer_div, a733sd_card_hz_max(sd.mod_hz, sd.xfer_div));
+
+	lck_mtx_lock(&a733_sd_lock);
+	error = smhc_reset();
+	if (error) {
+		printf("A733 SD: controller reset timed out (GCTRL 0x%08x)\n", smhc_rd(SMHC_GCTRL));
+		lck_mtx_unlock(&a733_sd_lock);
+		return error;
+	}
+
+	for (int attempt = 0; attempt < 2; attempt++) {
+		error = sd_identify();
+		if (!error) {
+			break;
+		}
+		printf("A733 SD: card initialisation attempt %d failed: %d\n", attempt + 1, error);
+		smhc_reset();
+	}
+	if (!error) {
+		printf("A733 SD: card RCA 0x%04x, %llu MiB, %s bus\n", sd.rca,
+		    sd.card_sectors >> 11, sd.wide ? "4-bit" : "1-bit");
+		error = sd_find_partition(idx);
+	}
+	struct a733sd_hfs hfs = { 0 };
+	int hfs_error = ENXIO;
+	if (!error) {
+		error = sd_read(sd.part.start + 2, 1, sd_bounce);
+		if (!error) {
+			hfs_error = a733sd_hfs_check((const uint8_t *)sd_bounce, sd.part.count, &hfs);
+		}
+	}
+	lck_mtx_unlock(&a733_sd_lock);
+	if (error) {
+		return error;
+	}
+
+	printf("A733 SD: partition %u: %s%s%s start sector %llu, %llu MiB\n", idx,
+	    sd.part.mbr_type ? "MBR" : "GPT", sd.part.name[0] ? " " : "", sd.part.name,
+	    sd.part.start, sd.part.count >> 11);
+	if (hfs_error == 0) {
+		printf("A733 SD: %s volume v%u, %u x %u bytes, %s%s\n",
+		    hfs.signature == HFS_SIG_X ? "HFSX" : "HFS+", hfs.version, hfs.total_blocks,
+		    hfs.block_size, (hfs.attributes & HFS_ATTR_UNMOUNTED) ? "cleanly unmounted" : "NOT cleanly unmounted",
+		    (hfs.attributes & HFS_ATTR_JOURNALED) ? ", journaled" : "");
+	} else {
+		printf("A733 SD: partition %u: %s (signature 0x%04x)\n", idx,
+		    hfs.signature == HFS_SIG_WRAPPER ? "HFS wrapper volume, unsupported" :
+		    hfs_error == EFBIG ? "HFS+ volume larger than the partition" : "no HFS+/HFSX volume header",
+		    hfs.signature);
+		if (!force) {
+			return EFTYPE;
+		}
+		printf("A733 SD: sdforce=1, exposing the partition anyway\n");
+	}
+
+	sd.secsize = DEV_BSIZE;
+	sd.bmajor = bdevsw_add(-1, &a733_sd_bdevsw);
+	if (sd.bmajor < 0) {
+		return ENXIO;
+	}
+	sd.cmajor = cdevsw_add_with_bdev(-1, &a733_sd_cdevsw, sd.bmajor);
+	if (sd.cmajor < 0) {
+		return ENXIO;
+	}
+	sd.bdev = makedev(sd.bmajor, 0);
+	devfs_make_node(sd.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "sdroot0");
+	devfs_make_node(makedev(sd.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rsdroot0");
+	sd.next_report = 64ull << 20;
+	sd.ready = true;
+	printf("A733 SD: sdroot0 ready, read-only PIO\n");
+	return 0;
+}
+
+/* Root device for rd=sdroot0 (IOFindBSDRoot). */
+int a733_sd_rootdev(dev_t *dev);
+
+int
+a733_sd_rootdev(dev_t *dev)
+{
+	if (!sd.ready) {
+		int error = a733_sd_init();
+		if (error) {
+			return error;
+		}
+	}
+	*dev = sd.bdev;
+	return 0;
+}
+#endif /* !A733_SD_HOST_TEST */
+#endif /* ARM64_BOARD_CONFIG_SWEET || A733_SD_HOST_TEST */
